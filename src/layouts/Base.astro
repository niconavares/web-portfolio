---
import '../styles/global.css';
import { contact } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Nicolás Navares · Analista SOC / Blue Team',
  description = 'Portfolio de Nicolás Navares — analista SOC / Blue Team en Santa Cruz de Tenerife. Homelab SOC con Splunk, honeypot T-Pot SOCEmpire con +1M de ataques reales, threat hunting y DFIR.',
} = Astro.props;
---
<!doctype html>
<html lang="es" data-lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={contact.name} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0A0A0C" />
    <link rel="canonical" href="https://navares.vercel.app/" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={contact.name} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://navares.vercel.app/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://navares.vercel.app/og.png" />

    <title>{title}</title>

    <!-- Datos estructurados: Persona (SEO / Google Knowledge) -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: contact.name,
        jobTitle: 'Analista SOC / Blue Team',
        email: `mailto:${contact.email}`,
        address: { '@type': 'PostalAddress', addressLocality: 'Santa Cruz de Tenerife', addressCountry: 'ES' },
        url: 'https://navares.vercel.app/',
        sameAs: [contact.linkedin, contact.github, contact.credly],
        knowsAbout: ['SOC', 'Blue Team', 'Splunk', 'Elastic Stack', 'Suricata', 'Threat Hunting', 'DFIR', 'MITRE ATT&CK', 'Incident Response'],
      })}
    />

    <!-- Idioma inicial antes de pintar, para evitar flash del idioma equivocado. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('lang');
          var lang = stored === 'en' || stored === 'es'
            ? stored
            : (navigator.language || 'es').toLowerCase().startsWith('en') ? 'en' : 'es';
          document.documentElement.setAttribute('data-lang', lang);
          document.documentElement.setAttribute('lang', lang);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/reveal.ts';
    </script>
  </body>
</html>

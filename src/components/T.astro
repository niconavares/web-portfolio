---
// Render bilingüe: pinta ambos idiomas; CSS muestra el activo según html[data-lang].
// Sin flash: el idioma inicial se fija en un script inline del <head> (Base.astro).
interface Props {
  es: string;
  en: string;
  as?: keyof HTMLElementTagNameMap;
  class?: string;
}
const { es, en, as: Tag = 'span', class: className } = Astro.props;
---
<Tag class={className}>
  <span data-lang-es set:html={es} />
  <span data-lang-en set:html={en} />
</Tag>

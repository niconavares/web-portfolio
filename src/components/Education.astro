---
import Section from './Section.astro';
import { education, contact, ui } from '../data/site';
---
<Section id="education" es={ui.sections.education.es} en={ui.sections.education.en} index="05">
  <div class="grid gap-12 md:grid-cols-2">
    <!-- Formación -->
    <div class="flex flex-col gap-8" data-reveal>
      <div>
        <h3 class="font-display text-lg font-bold text-paper">{education.bootcamp.title}</h3>
        <p class="mb-2 font-mono text-sm text-steel">{education.bootcamp.period}</p>
        <p class="font-body text-sm leading-relaxed text-paper/75">
          <span data-lang-es>{education.bootcamp.modules.es}</span>
          <span data-lang-en>{education.bootcamp.modules.en}</span>
        </p>
      </div>
      <div>
        <h3 class="font-display text-lg font-bold text-paper">
          <span data-lang-es>{education.previousTraining.title}</span>
          <span data-lang-en>{education.previousTraining.titleEn}</span>
        </h3>
        <p class="mb-2 font-mono text-sm text-steel">{education.previousTraining.period}</p>
        <p class="font-body text-sm leading-relaxed text-paper/75">
          <span data-lang-es>{education.previousTraining.detail.es}</span>
          <span data-lang-en>{education.previousTraining.detail.en}</span>
        </p>
      </div>
    </div>

    <!-- Certificaciones -->
    <div class="flex flex-col gap-8" data-reveal style="--reveal-delay: 120ms;">
      <div>
        <h3 class="mb-4 font-mono text-sm uppercase tracking-wider text-steel">
          <span data-lang-es>Certificaciones profesionales</span>
          <span data-lang-en>Professional certifications</span>
        </h3>
        <ul class="flex flex-col gap-4">
          {
            education.certs.map((c) => (
              <li class="rounded-md border border-line/70 p-4">
                <div class="flex items-center justify-between gap-3">
                  <span class="font-body text-sm font-medium text-paper">{c.name}</span>
                  <span
                    class:list={[
                      'shrink-0 rounded-full border px-2 py-0.5 font-mono text-[0.65rem] uppercase tracking-wide',
                      c.done ? 'border-steel/50 text-steel' : 'border-line text-muted',
                    ]}
                  >
                    {c.done ? '✓' : '○'}
                    <span data-lang-es>{c.done ? ' Completado' : ' En curso'}</span>
                    <span data-lang-en>{c.done ? ' Completed' : ' In progress'}</span>
                  </span>
                </div>
                {c.detail.es && (
                  <p class="mt-1.5 font-body text-xs text-paper/60">
                    <span data-lang-es>{c.status.es} · {c.detail.es}</span>
                    <span data-lang-en>{c.status.en} · {c.detail.en}</span>
                  </p>
                )}
                {!c.detail.es && (
                  <p class="mt-1.5 font-body text-xs text-paper/60">
                    <span data-lang-es>{c.status.es}</span>
                    <span data-lang-en>{c.status.en}</span>
                  </p>
                )}
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="mb-3 font-mono text-sm uppercase tracking-wider text-steel">
          <span data-lang-es>{education.badges.intro.es}</span>
          <span data-lang-en>{education.badges.intro.en}</span>
        </h3>
        <ul class="flex flex-col gap-2">
          {
            education.badges.groups.map((g) => (
              <li class="font-body text-xs leading-relaxed text-paper/70">
                <span class="font-mono text-paper/90">{g.org}:</span> {g.items}
              </li>
            ))
          }
        </ul>
        <a
          href={contact.credly}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-block font-mono text-xs text-steel underline-offset-4 hover:underline"
        >
          credly.com/users/nicolas-jose-navares-sanchez ↗
        </a>
      </div>
    </div>
  </div>

  <!-- Formación insignia: el bootcamp destacado a lo ancho -->
  <div
    class="mt-12 rounded-lg border border-steel/40 bg-steel/[0.04] p-6 sm:p-8"
    data-reveal
    style="--reveal-delay: 80ms;"
  >
    <div class="flex flex-wrap items-center gap-3">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-steel/50 bg-steel/10 px-3 py-1 font-mono text-[0.65rem] uppercase tracking-wider text-steel">
        ★
        <span data-lang-es>{education.bootcampFeatured.label.es}</span>
        <span data-lang-en>{education.bootcampFeatured.label.en}</span>
      </span>
      <span class="font-mono text-xs text-muted">{education.bootcampFeatured.org} · {education.bootcamp.period}</span>
    </div>

    <h3 class="mt-4 font-display text-2xl font-bold text-paper sm:text-3xl">
      {education.bootcampFeatured.title}
    </h3>

    <p class="mt-3 max-w-3xl font-body text-sm leading-relaxed text-paper/75">
      <span data-lang-es>{education.bootcampFeatured.lead.es}</span>
      <span data-lang-en>{education.bootcampFeatured.lead.en}</span>
    </p>

    <dl class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
      {
        education.bootcampFeatured.facts.map((f) => (
          <div class="rounded-md border border-line/70 bg-ink/40 p-3">
            <dt class="font-display text-xl font-bold text-paper">{f.value}</dt>
            <dd class="mt-0.5 font-body text-xs text-paper/60">
              <span data-lang-es>{f.label.es}</span>
              <span data-lang-en>{f.label.en}</span>
            </dd>
          </div>
        ))
      }
    </dl>

    <p class="mt-6 mb-2 font-mono text-xs uppercase tracking-wider text-steel">
      <span data-lang-es>Módulos cursados</span>
      <span data-lang-en>Modules completed</span>
    </p>
    <ul class="flex flex-wrap gap-2">
      {
        education.bootcampFeatured.modules.map((m) => (
          <li class="rounded border border-line px-2.5 py-1 font-mono text-xs text-paper/80">{m}</li>
        ))
      }
    </ul>

    <p class="mt-5 font-body text-xs leading-relaxed text-paper/60">
      <span data-lang-es>{education.bootcampFeatured.extras.es}</span>
      <span data-lang-en>{education.bootcampFeatured.extras.en}</span>
    </p>
  </div>
</Section>
